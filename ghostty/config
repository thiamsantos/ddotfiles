theme = Dracula
font-size = 16
font-family = "SF Mono"
quit-after-last-window-closed = true
confirm-close-surface = true
# Unbind select_all so Cmd+a is available for other uses (e.g. hyper key combos).
keybind = super+a=unbind
# Hyper+a forwards Ctrl+a (\x01) to zellij — unlocks and enters Normal mode.
keybind = ctrl+super+alt+a=text:\x01