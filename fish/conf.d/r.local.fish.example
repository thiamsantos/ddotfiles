# Copy to ~/.config/fish/conf.d/r.local.fish and fill in your environments.
# `r` (fish/functions/r.fish) calls __r_env_config to resolve each short name.
# Echo four space-separated fields:
#   env_name app pod release_bin
# env_name is a `remotectl use` environment (staging, sandbox, production, ...).
function __r_env_config --argument env_short
    switch $env_short
        case stg
            echo <env-name> <app> <pod> <release-bin>
        case sand
            echo <env-name> <app> <pod> <release-bin>
        case prod
            echo <env-name> <app> <pod> <release-bin>
        case review
            echo <env-name> <app> <pod> <release-bin>
    end
end
